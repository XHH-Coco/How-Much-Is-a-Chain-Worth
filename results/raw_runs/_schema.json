{
  "schema": "b2-run/1",
  "required": [
    "run_id",
    "task_id",
    "arm_id",
    "seed",
    "split",
    "config_sha256",
    "metrics",
    "env_fingerprint",
    "status"
  ],
  "metric_keys": [
    "r2",
    "mae",
    "rmse"
  ],
  "status_values": [
    "ok",
    "failed",
    "timeout",
    "skipped"
  ],
  "invariant": "a run record is written once and never edited; a re-run gets a new run_id"
}
