                <Text style={{ fontSize: 13, color: '#8FA3BC', marginTop: 4, lineHeight: 1.5 }}>303 个可用 run 级数值的中位数</Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.05 }}>−0.859</Text>
                <Text style={{ fontSize: 13, color: '#8FA3BC', marginTop: 4, lineHeight: 1.5 }}>最稳的负值：op_tm × A3，75 行可算</Text>
            </Box>
            <Box style={{ flexDirection: 'column' }}>
                <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#FFB020', lineHeight: 1.05 }}>+0.638</Text>
                <Text style={{ fontSize: 13, color: '#8FA3BC', marginTop: 4, lineHeight: 1.5 }}>最大正值 —— 但 15 行里只有 6 行可算</Text>
