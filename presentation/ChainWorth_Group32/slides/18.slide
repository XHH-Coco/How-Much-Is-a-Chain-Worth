<Slide style={{ width: 1280, height: 720, background: '#0A1020', fontFamily: 'Arial', padding: '52px 60px 30px 60px', display: 'flex', flexDirection: 'column' }}>
    <Text style={{ fontSize: 14, color: '#4D8DFF', fontWeight: 'bold', letterSpacing: 2.2 }}>11 · REFERENCES</Text>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2, marginTop: 8 }}>
        References and data sources
    </Text>
    <Box style={{ width: 1160, height: 1, background: '#24334C', marginTop: 14 }} />

    <Box style={{ flexDirection: 'column', marginTop: 10 }}>
        {[
            ['1', 'PolyBench — A Reproducible Open Benchmark Platform for Repeat-Unit-Based Polymer Property Prediction',
                'Polym. Sci. Technol. 2026, 2(10), 836–854 · DOI 10.1021/polymscitech.6c00094 · polybench.ciac.jl.cn'],
            ['2', 'PolyBench26 — An open benchmark for machine-learning-based polymer property prediction',
                'arXiv:2609.27036 · github.com/rlearsch/PolymerBenchmark2026'],
            ['3', 'OpenPoly — A Polymer Database Empowering Benchmarking and Multi-property Predictions',
                'Chin. J. Polym. Sci. 2025, 43(10), 1749–1760 · DOI 10.1007/s10118-025-3402-y · github.com/WangGroupFDU/Openpoly_benchmark'],
            ['4', 'chemprop 2.1.0 — directed message-passing neural network (arm A3, official hyper-parameters)',
                'github.com/chemprop/chemprop'],
            ['5', 'polyBERT — polymer language-model embeddings (arm A4, frozen encoder)',
                'huggingface.co/kuelumbus/polyBERT'],
            ['6', 'RDKit — 205 descriptors and 2048-bit Morgan fingerprints (arm A2)',
                'rdkit.org'],
            ['7', 'XGBoost — Chen & Guestrin, Proceedings of KDD 2016',
                'xgboost.readthedocs.io'],
        ].map(([num, title, source]) => (
            <Box key={num} style={{ flexDirection: 'row', gap: 14, paddingTop: 5, paddingBottom: 5, borderTop: '1px solid #1A2537' }}>
                <Text style={{ fontSize: 14, color: '#4D8DFF', width: 18, fontWeight: 'bold', lineHeight: 1.4 }}>{num}</Text>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 14, color: '#FFFFFF', lineHeight: 1.3 }}>{title}</Text>
                    <Text style={{ fontSize: 12, color: '#93A8C2', marginTop: 1, lineHeight: 1.3 }}>{source}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    <Box style={{ marginTop: 'auto', padding: '11px 20px', background: '#16233A', borderLeft: '3px solid #4D8DFF' }}>
        <Text style={{ fontSize: 18, color: '#FFFFFF', fontWeight: 'bold', lineHeight: 1.25 }}>
            github.com/XHH-Coco/How-Much-Is-a-Chain-Worth
        </Text>
        <Text style={{ fontSize: 15, color: '#A8B8CE', marginTop: 4, lineHeight: 1.35 }}>
            Every number in this deck is regenerated by scripts in that repository; appendix B of the report lists the tables those scripts write.
        </Text>
    </Box>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 10 }}>
        <Text style={{ fontSize: 14, color: '#8FA3BC' }}>Group 32 · How Much Is a Chain Worth?</Text>
        <Text style={{ fontSize: 14, color: '#8FA3BC' }}>18 / 18</Text>
    </Box>
