<Slide style={{ width: 1280, height: 720, background: '#0A1020', fontFamily: 'Arial', padding: '52px 60px 30px 60px', display: 'flex', flexDirection: 'column' }}>
    <Text style={{ fontSize: 12, color: '#4D8DFF', fontWeight: 'bold', letterSpacing: 2.2 }}>11 · REFERENCES</Text>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.2, marginTop: 8 }}>
        References and data sources
    </Text>
    <Box style={{ width: 1160, height: 1, background: '#24334C', marginTop: 14 }} />

    <Box style={{ flexDirection: 'column', marginTop: 14 }}>
        {[
            ['1', 'PolyBench — A Reproducible Open Benchmark Platform for Repeat-Unit-Based Polymer Property Prediction',
                'Polym. Sci. Technol. 2026, 2(10), 836–854 · DOI 10.1021/polymscitech.6c00094 · platform http://polybench.ciac.jl.cn · archive https://doi.org/10.6084/m9.figshare.30917717'],
            ['2', 'PolyBench26 — An open benchmark for machine-learning-based polymer property prediction',
                'arXiv:2609.27036 · https://github.com/rlearsch/PolymerBenchmark2026'],
            ['3', 'OpenPoly — A Polymer Database Empowering Benchmarking and Multi-property Predictions',
                'Chin. J. Polym. Sci. 2025, 43(10), 1749–1760 · DOI 10.1007/s10118-025-3402-y · https://github.com/WangGroupFDU/Openpoly_benchmark'],
            ['4', 'chemprop 2.1.0 — directed message-passing neural network (arm A3, official hyper-parameters)',
                'https://github.com/chemprop/chemprop'],
            ['5', 'polyBERT — polymer language-model embeddings (arm A4, frozen encoder)',
                'https://huggingface.co/kuelumbus/polyBERT'],
            ['6', 'RDKit — 205 descriptors and 2048-bit Morgan fingerprints (arm A2)',
                'https://www.rdkit.org'],
            ['7', 'XGBoost — Chen & Guestrin, Proceedings of KDD 2016',
                'https://xgboost.readthedocs.io'],
        ].map(([num, title, source]) => (
            <Box key={num} style={{ flexDirection: 'row', gap: 16, paddingTop: 9, paddingBottom: 9, borderTop: '1px solid #1A2537' }}>
                <Text style={{ fontSize: 12, color: '#4D8DFF', width: 16, fontWeight: 'bold', lineHeight: 1.5 }}>{num}</Text>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 13, color: '#FFFFFF', lineHeight: 1.4 }}>{title}</Text>
                    <Text style={{ fontSize: 11, color: '#7E93AE', marginTop: 2, lineHeight: 1.45 }}>{source}</Text>
                </Box>
            </Box>
        ))}
    </Box>

    <Box style={{ marginTop: 'auto', flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 11, color: '#5E7590', width: 900, lineHeight: 1.5 }}>
            Every number in this deck is regenerated by scripts in the project repository; per-number provenance is tabulated in docs/研究报告.md, appendix B.
        </Text>
        <Text style={{ fontSize: 12, color: '#5E7590' }}>17 / 17</Text>
    </Box>
</Slide>
