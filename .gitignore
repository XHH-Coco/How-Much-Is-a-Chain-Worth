# ---- data: keep pointers, not payloads -------------------------------
# '*' rather than 'dir/': the directory itself must survive a clone so the
# skeleton is visible on a fresh checkout; only its contents are ignored.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# 限量跑的清单是调试产物，不是证据：`--limit` 只许写 *.partial.csv，完整清单才入库。
# A --limit run writes *.partial.csv as a debugging artefact; only the full manifest is evidence.
data/manifests/*.partial.csv

# ---- weights and caches (polyBERT alone is 7.3 GB) -------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.h5
*.pkl
*.joblib
.cache/
hf_cache/
*.onnx

# ---- run artefacts ----------------------------------------------------
logs/
wandb/
mlruns/
lightning_logs/
outputs/
*.log
*.tmp
runs/

# ---- environments -----------------------------------------------------
.venv/
env/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp*/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
build/
dist/

# ---- OS / IDE ---------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- agent scaffolding ------------------------------------------------
# Anything a coding agent creates for itself: a tool cache, a session log,
# a hidden workspace. None of it is reproducible by a teammate who clones
# this repository, so none of it belongs in the record.
# 组员若使用 agent，请自行在本节补全由 agent 生成、无需版本控制的内容。
.workbuddy/
.tools/
.agent/
.agents/
.claude/
.codex/
.cursor/
.windsurf/
.serena/
.continue/
.aider*
*.bak
*.orig
*.rej

# ---- throwaway scripts ------------------------------------------------
# scripts/ keeps the reproducible stage entry points (00-07) and IS
# committed.  scripts/ 只入库阶段入口；临时/一次性脚本放 _scratch/，
# 永不提交——它们换个机器就复现不了，留着只会让人误以为能跑。
scripts/_scratch/

# ---- NEVER ignore these (protocol artefacts and evidence) -------------
# splits/*.json      <- official 70/30 and 5-fold indices
# data/manifests/*   <- task lists, sha256, counts
# results/raw_runs/  <- one JSON per run, the traceable evidence
# results/aggregate/ <- computed Lambda / kappa tables
# Note: do not add blanket '*.csv' or '*.json' rules. They would
# silently drop exactly the files this repository exists to preserve.
